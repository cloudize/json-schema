{
  "name": "@cloudize/json-schema",
  "author": {
    "name" : "Cloudize Limited",
    "email" : "hello@cloudize.net",
    "url" : "https://cloudize.net"
  },
  "contributors": [
    {
      "name" : "Erich Kuba",
      "email" : "erich.kuba@cloudize.net"
    }
  ],
  "description": "Cloudize JSON Schema Validation Library",
  "license": "MIT",
  "version": "27.1.1",
  "type": "commonjs",
  "engines": {
    "node": ">=26"
  },
  "files": ["lib"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.jest.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:build": "jest --config build.jest.config.js --coverage",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:watch": "jest --config jest.config.js --watch",
    "lint": "eslint src tests --ext .ts,.js",
    "build": "npm run clean && npm run lint && npm run typecheck && tsc && npm run typecheck:tests && npm run test && npm run test:build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@cloudize/json": "^27.1.1",
    "deep-equal": "^2.2.3",
    "jsonschema": "^1.5.0",
    "lodash.clonedeep": "^4.5.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudize/json-schema.git"
  },
  "bugs": {
    "url": "https://github.com/cloudize/json-schema/issues"
  },
  "homepage": "https://github.com/cloudize/json-schema#readme"
}
